# TIM (Tourism Investment Monitor) — environment variables

# --- Database (Prisma) -------------------------------------------------------
# Local/dev defaults to SQLite (prisma/dev.db, created by `prisma migrate dev`).
# For a real deployment, point this at a hosted Postgres instance (Neon, Supabase,
# Vercel Postgres, etc.) — the schema (prisma/schema.prisma) is written in a
# Postgres-portable subset, so this is a datasource-provider + connection-string
# change, not a schema rewrite. See AUDIT.md §3.
DATABASE_URL="file:./dev.db"

# --- Auth (NextAuth / Auth.js) -----------------------------------------------
# Required in any deployed environment. Generate with: npx auth secret
AUTH_SECRET=

# The current auth provider is a DEV-MODE credentials login (email + self-selected
# role, no password) — see lib/auth.ts. It is a placeholder for a real Entra ID
# app registration; swapping it in only needs these three values plus registering
# an AzureADProvider in lib/auth.ts:
# AZURE_AD_CLIENT_ID=
# AZURE_AD_CLIENT_SECRET=
# AZURE_AD_TENANT_ID=

# --- Public source adapters ---------------------------------------------------
# Every source in lib/sources/* works without any key except Ticketmaster.
# Without the key, comparable-event/venue data falls back to a cited
# benchmark default (flagged as "Medium confidence" in the app) — the app
# is fully functional either way.

# Free tier, 5,000 requests/day: https://developer.ticketmaster.com/products-and-docs/apis/discovery-api/v2/
TICKETMASTER_API_KEY=
